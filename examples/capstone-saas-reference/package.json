    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@scalar/hono-api-reference": "^0.9.0",
    "bullmq": "^5.77.0",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "hono": "4.13.10",
    "jose": "^6.0.0",
    "pino": "^9.6.0",
